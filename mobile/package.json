{
  "name": "paroisse-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "bash expo-ios.sh",
    "ios-direct": "CI=1 __UNSAFE_EXPO_HOME_DIRECTORY=/tmp/expo_ios expo run:ios",
    "web": "__UNSAFE_EXPO_HOME_DIRECTORY=\"$PWD/.expo-web-home\" npx expo start --web --host lan --port 8083",
    "web-clean": "rm -rf \"$PWD/.expo-web-home\" && npm run web",
    "simulate": "../backend/.venv/bin/python3 ../scripts/simulate_mobile.py",
    "postinstall": "node scripts/fix-expo-device.js && node scripts/patch-fmt.js && node scripts/patch-react-native-svg.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "axios": "^1.6.0",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.23",
    "expo-device": "~57.0.2",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-modules-core": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "^0.86.3",
    "@types/react": "~19.2.4",
    "@types/react-navigation": "^3.4.0",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
